# Docker Compose settings (copied to .env at the project root)
# Your Linux user ID and group ID keep bind-mounted files editable.
UID=1000
GID=1000

# MySQL container credentials
DB_DATABASE=team_tasks
DB_USERNAME=laravel
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Frontend -> API URL (browser-facing)
VITE_API_URL=http://localhost:8000/api
